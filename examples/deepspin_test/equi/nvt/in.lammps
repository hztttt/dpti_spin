clear
# --------------------- VARIABLES-------------------------
variable        NSTEPS          equal 100000
variable        THERMO_FREQ     equal 10
variable        DUMP_FREQ       equal 10000
variable        NREPEAT         equal ${NSTEPS}/${DUMP_FREQ}
variable        TEMP            equal 200.000000
variable        SP_MASS         equal 0.010000
variable        PRES            equal 0.000000
variable        TAU_T           equal 0.100000
variable        TAU_P           equal 1.000000
# ---------------------- INITIALIZAITION ------------------
units           metal
boundary        p p p
atom_style      spin
# --------------------- ATOM DEFINITION ------------------
box             tilt large
read_data       conf.lmp
change_box      all triclinic
mass            1 55.845000
# --------------------- FORCE FIELDS ---------------------
pair_style      deepspin frozen_model.pth
pair_coeff * *
# --------------------- MD SETTINGS ----------------------
neighbor        1.0 bin
timestep        0.001000
thermo          ${THERMO_FREQ}
compute         allmsd all msd
compute         spin all property/atom sp spx spy spz fmx fmy fmz
thermo_style    custom step ke pe etotal enthalpy temp press vol lx ly lz xy xz yz pxx pyy pzz pxy pxz pyz c_allmsd[*]
compute         ru all property/atom xu yu zu
fix             ap all ave/atom ${DUMP_FREQ} ${NREPEAT} ${NSTEPS} c_ru[1] c_ru[2] c_ru[3]
dump            fp all custom ${NSTEPS} dump.avgposi id type f_ap[1] f_ap[2] f_ap[3]
dump            1 all custom ${DUMP_FREQ} dump.equi id type x y z vx vy vz c_spin[1] c_spin[2] c_spin[3] c_spin[4] c_spin[5] c_spin[6] c_spin[7]
fix             1 all nvt temp ${TEMP} ${TEMP} ${TAU_T} mass ${SP_MASS} rand 58677
fix             mzero all momentum 10 linear 1 1 1
# --------------------- INITIALIZE -----------------------
velocity        all create ${TEMP} 38193 spin yes spmass ${SP_MASS}
velocity        all zero linear
# --------------------- RUN ------------------------------
run             ${NSTEPS}
undump           fp
undump           1
unfix            ap
read_dump        dump.avgposi ${NSTEPS} x y z label x f_ap[1] label y f_ap[2] label z f_ap[3]
write_data      out.lmp
